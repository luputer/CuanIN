+export function DataTableBodySkeleton({
+    columns = 6,
+    rows = 5,
+}: {
+    columns?: number;
+    rows?: number;
+}) {
+    return (
+        <>
+            {Array.from({ length: rows }).map((_, rowIndex) => (
+                <TableRow key={rowIndex} data-type="body">
+                    {Array.from({ length: columns }).map((_, colIndex) => (
